{
  "opencollection": "1.0.0",
  "info": {
    "name": "Blink Server-Side Authentication Users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the Blink user profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.blink.net/oauth/access_token/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the Blink user profile, based on a valid authorization code that was previously obtained in a web application using Login with Blink."
        }
      ]
    }
  ],
  "bundled": true
}